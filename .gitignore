# --- OS / editor noise ---
.DS_Store
**/.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
# Virtualenvs are recreated from pyproject.toml, never committed.
.venv/
venv/
env/

# --- Secrets / local config ---
# Never commit real environment files. backend/.env.example documents the keys.
.env
.env.*
!.env.example

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*